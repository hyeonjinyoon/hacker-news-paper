@page "/{date?}"
@model IndexModel
@{
    var e = Model.Edition;
    ViewData["Title"] = e is null ? "Hacker News paper" : $"Hacker News paper · {e.Date}";
    ViewData["DateLabel"] = e?.DateLabel;
}
@* 기사는 분류하지 않고 HN 순위대로 고정된 자리에 놓는다(EditionBuilder.Plan). *@

@if (e is null)
{
<main class="empty">
  <p>아직 발행된 호가 없습니다.</p>
  <p>저장소에서 Claude Code를 열고 <code>/hn-paper-update</code>를 실행하면 오늘자 호가 만들어집니다.</p>
</main>
}
else
{
<main>
@if (!e.Translated)
{
  <p class="notice">이 호는 아직 번역 전입니다. 원문 제목으로 표시합니다.</p>
}

@* 1위 톱 · 2–3위 보조 · 4–5위 오른쪽 사진 *@
<section class="top" id="top">
  <div class="lead">
    @if (e.Hero is { } hero)
    {
    <article class="hero linkbox">
      <h1><a href="@hero.Href">@hero.Title</a></h1>
      <div class="hero-body">
        <partial name="_HeroVisual" model="hero" />
        <div class="lede">
          <div class="lede-text">
            @foreach (var paragraph in e.Lead)
            {
              <p>@paragraph</p>
            }
          </div>
          <partial name="_Meta" model="new Meta(hero, true)" />
        </div>
      </div>
    </article>
    }
    @if (e.Subs.Count > 0)
    {
    <div class="subs">
      @foreach (var s in e.Subs)
      {
      <article class="sub linkbox">
        <partial name="_Thumb" model="s" />
        <div>
          <partial name="_Story" model="s" />
          @if (s.Summary is not null)
          {
            <p class="desc">@s.Summary</p>
          }
          <partial name="_Meta" model="new Meta(s)" />
        </div>
      </article>
      }
    </div>
    }
  </div>
  <aside class="side">
    @foreach (var s in e.Side)
    {
    <article class="card linkbox">
      <partial name="_Thumb" model="s" />
      <partial name="_Story" model="s" />
      <partial name="_Meta" model="new Meta(s)" />
    </article>
    }
  </aside>
</section>

@* 6위 사진 · 7–12위 헤드라인 · 13–18위 목록 *@
@if (e.Photo is not null || e.Headlines.Count > 0)
{
<section class="band band-3">
  <div class="col-a photo-lead">
    @if (e.Photo is { } photo)
    {
    <article class="linkbox">
      <partial name="_Thumb" model="photo" />
      <partial name="_Story" model="photo" />
      @if (photo.Summary is not null)
      {
        <p class="desc">@photo.Summary</p>
      }
      <partial name="_Meta" model="new Meta(photo)" />
    </article>
    }
  </div>
  <div class="col-b">
    <ul class="headlines">
      @foreach (var s in e.Headlines)
      {
        <li class="linkbox"><partial name="_Story" model="s" /><partial name="_Meta" model="new Meta(s)" /></li>
      }
    </ul>
  </div>
  <div class="col-c">
    <ul class="briefs">
      @foreach (var s in e.Briefs)
      {
        <li class="linkbox"><partial name="_Story" model="s" /><partial name="_Meta" model="new Meta(s)" /></li>
      }
    </ul>
  </div>
</section>
}

@* 19–22위 사진 칸 · 23–26위 글 목록 · 27–30위 사진 칸 | 많이 본 뉴스 · 댓글 많은 뉴스 *@
<section class="band split">
  <div class="main">
    @if (e.GridA.Count > 0)
    {
    <div class="grid4">
      @foreach (var s in e.GridA)
      {
        <article class="linkbox"><partial name="_Thumb" model="s" /><partial name="_Story" model="s" /><partial name="_Meta" model="new Meta(s)" /></article>
      }
    </div>
    }
    @if (e.ListA.Count > 0)
    {
    <ul class="textlist">
      @foreach (var s in e.ListA)
      {
        <li class="linkbox">
          <partial name="_Story" model="s" />
          @if (s.Summary is not null)
          {
            <p class="desc">@s.Summary</p>
          }
          <partial name="_Meta" model="new Meta(s)" />
        </li>
      }
    </ul>
    }
    @if (e.GridB.Count > 0)
    {
    <div class="grid4 grid-next">
      @foreach (var s in e.GridB)
      {
        <article class="linkbox"><partial name="_Thumb" model="s" /><partial name="_Story" model="s" /><partial name="_Meta" model="new Meta(s)" /></article>
      }
    </div>
    }
  </div>
  <aside class="aside">
    <div class="box" id="popular">
      <div class="sec-head"><h2>많이 본 뉴스</h2></div>
      <ol class="ranking">
        @* 1면에서는 왼쪽 기사 칸과 높이를 맞추려고 상위 5개만 보인다. 기사 페이지 오른쪽 칸은 10개. *@
        @foreach (var (s, i) in e.ByPoints.Take(5).Select((s, i) => (s, i + 1)))
        {
          <li class="linkbox"><span class="n">@i</span><div><h3><a href="@s.Href">@s.Title</a></h3><p class="pts">▲ @s.Raw.Points · 댓글 @s.Raw.Comments</p></div></li>
        }
      </ol>
    </div>
    <div class="box" id="comments">
      <div class="sec-head"><h2>댓글 많은 뉴스</h2></div>
      <ol class="ranking">
        @foreach (var (s, i) in e.ByComments.Select((s, i) => (s, i + 1)))
        {
          <li class="linkbox"><span class="n">@i</span><div><h3><a href="@s.Href">@s.Title</a></h3><p class="pts">댓글 @s.Raw.Comments · ▲ @s.Raw.Points</p></div></li>
        }
      </ol>
    </div>
  </aside>
</section>

@if (e.More.Count > 0)
{
<section class="band">
  <div class="sec-head"><h2>그 밖의 뉴스</h2></div>
  <ul class="textlist">
    @foreach (var s in e.More)
    {
      <li class="linkbox"><partial name="_Story" model="s" /><partial name="_Meta" model="new Meta(s)" /></li>
    }
  </ul>
</section>
}

<section class="band" id="rank">
  <div class="sec-head"><h2>Hacker News 1면 전체 순위</h2><span class="meta">@(e.Translated ? "원제 병기 · " : "")@(e.All.Count)위까지</span></div>
  <ol class="fulllist">
    @foreach (var s in e.All)
    {
      <li class="linkbox">
        <span class="n">@s.Raw.Rank</span>
        <div>
          <h3><a href="@s.Href">@s.Title</a></h3>
          @if (e.Translated)
          {
            <p class="en">@s.Raw.Title</p>
          }
          <partial name="_Meta" model="new Meta(s, true)" />
        </div>
      </li>
    }
  </ol>
</section>
</main>

@section FooterNav {
  <nav class="edition-nav" aria-label="호 이동">
    @if (Model.PrevDate is { } prev)
    {
      <a href="/@prev">← @prev 호</a>
    }
    <a href="/editions">지난 호 전체</a>
    @if (Model.NextDate is { } next)
    {
      <a href="/@next">@next 호 →</a>
    }
    <a class="to-top" href="#">맨 위로 ↑</a>
  </nav>
}
}
