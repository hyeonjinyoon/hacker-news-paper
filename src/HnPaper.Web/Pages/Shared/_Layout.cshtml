@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion
@{
    // 1면이 아닌 페이지에서는 섹션 앵커가 1면으로 돌아가야 한다.
    var navBase = ViewData["NavBase"] as string ?? "";
    var title = ViewData["Title"] as string ?? "Hacker News paper";
    const string description = "전날 Hacker News 1면 상위 30개 글을 매일 아침 한국어로 옮기는 신문형 페이지";
    // 공유 이미지(scripts/og-image.html로 만든 wwwroot/og.png)는 절대 주소여야 한다. 내용이 바뀌면 ?v=도 바뀐다.
    var ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}"
        + FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/og.png"));
}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@title</title>
<meta name="description" content="@description">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Hacker News paper">
<meta property="og:locale" content="ko_KR">
<meta property="og:title" content="@title">
<meta property="og:description" content="@description">
<meta property="og:image" content="@ogImage">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Hacker News paper — 전날 Hacker News 1면 상위 30개 글을 매일 아침 한국어로">
<meta name="twitter:card" content="summary_large_image">
@* 글꼴: Pretendard Variable (github.com/orioncactus/pretendard, 공식 안내의 jsDelivr 동적 서브셋) *@
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
@* 버전을 붙여 아이콘을 바꾸면 브라우저가 캐시한 옛 아이콘 대신 새 아이콘을 받게 한다. *@
<link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true">
<link rel="stylesheet" href="~/css/paper.css" asp-append-version="true">
</head>
<body>
<div class="wrap">
<header>
  <div class="util">
    <nav aria-label="바로가기">
      <a href="/editions">지난 호</a>
      <a href="https://news.ycombinator.com/" target="_blank" rel="noopener">Hacker News 원문</a>
    </nav>
  </div>
  <div class="masthead">
    <a class="logo" href="/">Hacker News<small>paper</small></a>
    <nav class="gnb" aria-label="섹션">
      <a href="@(navBase)#top">주요뉴스</a>
      <a href="@(navBase)#popular">많이 본 뉴스</a>
      <a href="@(navBase)#comments">댓글 많은 뉴스</a>
      <a href="@(navBase)#rank">전체 순위</a>
      <a href="/editions">지난 호</a>
    </nav>
    <div class="tools">
      <a href="https://hn.algolia.com/" target="_blank" rel="noopener" aria-label="Hacker News 검색"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.6-4.6"/></svg></a>
      <a href="https://news.ycombinator.com/" target="_blank" rel="noopener" aria-label="Hacker News 원문 열기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
    </div>
  </div>
</header>

@RenderBody()

<footer>
  <div class="logo">Hacker News<small>paper</small></div>
  @if (ViewData["DateLabel"] is string dateLabel)
  {
    <p class="edition-date">@dateLabel</p>
  }
  @await RenderSectionAsync("FooterNav", required: false)
  <p>매일 아침 전날 Hacker News(news.ycombinator.com) 1면에 오른 상위 30개 글의 제목을 한국어로 옮기고 짧게 요약하는 비공식 페이지입니다. 포인트와 댓글 수는 수집 시점의 값입니다.</p>
  <p>각 글의 저작권은 원 출처에 있습니다. 제목을 누르면 한국어 요약과 번역 댓글이 있는 기사 페이지가 열리고, 그곳에서 원문과 Hacker News 토론으로 갈 수 있습니다.</p>
  <p class="repo-link"><a href="https://github.com/hyeonjinyoon/hacker-news-paper" target="_blank" rel="noopener">소스 코드 · GitHub ↗</a></p>
</footer>
</div>
<script>
// "3시간 전" 같은 표기(_Ago)를 수집 시각이 아니라 보는 사람의 현재 시각 기준으로 계산하고, 1분마다 고친다.
// 규칙은 EditionBuilder.RelativeAge와 같다. 스크립트가 없으면 서버가 페이지를 그린 시각 기준 값이 남는다.
(() => {
  const ago = t => {
    const minutes = Math.floor((Date.now() / 1000 - t) / 60);
    if (minutes < 60) return `${Math.max(1, minutes)}분 전`;
    if (minutes < 1440) return `${Math.floor(minutes / 60)}시간 전`;
    return `${Math.floor(minutes / 1440)}일 전`;
  };
  const update = () => document.querySelectorAll('time[data-ago]').forEach(el => { el.textContent = ago(Number(el.dataset.ago)); });
  update();
  setInterval(update, 60000);
})();
</script>
</body>
</html>
