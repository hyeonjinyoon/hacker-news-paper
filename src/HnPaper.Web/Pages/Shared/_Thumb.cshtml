@model StoryView
@inject HnPaper.Web.Services.GradientLibrary Gradients
@{
    var panel = Gradients.UrlFor(Model);
}
@* og 이미지가 있으면 그 위에 덮고, 없거나 불러오지 못하면 그라데이션 패널 이미지가 보인다. *@
<a class="thumb" style="@(panel is null ? null : $"background-image:url('{panel}')")" href="@Model.Href" tabindex="-1" aria-hidden="true">
  @if (Model.HasImage)
  {
    <img src="@Model.ImageSmallUrl" srcset="@Model.ImageSrcset" sizes="(max-width:720px) 100vw, 300px" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">
  }
</a>
