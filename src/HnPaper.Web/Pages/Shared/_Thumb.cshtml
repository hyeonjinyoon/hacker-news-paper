@model StoryView
@inject HnPaper.Web.Services.GradientLibrary Gradients
@{
    var panel = Gradients.UrlFor(Model.Raw.Id);
}
@* og 이미지가 있으면 그 위에 덮고, 없거나 불러오지 못하면 그라데이션 패널 이미지가 보인다. *@
<a class="thumb" style="@(panel is null ? null : $"background-image:url('{panel}')")" href="@Model.Href" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
  @if (Model.HasImage)
  {
    <img src="@Model.Raw.Image" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
  }
</a>
