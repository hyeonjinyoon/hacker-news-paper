@page "/{date}/{id:long}"
@model StoryModel
@using HnPaper.Web.Services
@inject OgImageMaker OgImages
@{
    var e = Model.Edition;
    var s = Model.Story;
    var item = Model.Item;
    ViewData["Title"] = $"{s.Title} · Hacker Newspaper";
    ViewData["DateLabel"] = e.DateLabel;
    ViewData["NavBase"] = $"/{e.Date}";
    // 뉴욕타임스·동아일보 기사 페이지처럼 상단을 1면보다 작게 한 줄로 둔다.
    ViewData["CompactHeader"] = true;
    // 링크를 공유하면 사이트 공용 이미지 대신 이 기사의 제목·대표 이미지를 그린 이미지와 요약 첫 문단이 보인다.
    ViewData["OgType"] = "article";
    ViewData["OgTitle"] = s.Title;
    ViewData["OgDescription"] = s.Summary;
    ViewData["OgImage"] = $"~{s.Href}/og.jpg?v={OgImages.Key(s)}";
}
@* 동아일보 기사 페이지와 같은 칸 배치: 왼쪽 232px(비워 둠) · 본문 684px · 오른쪽 많이 본 뉴스 300px. 제목을 누르면 원문이, 원제를 누르면 Hacker News 글이, 댓글 제목을 누르면 Hacker News 댓글란이 열린다. *@
<div class="story-page">
  <header class="article-head">
    <nav class="crumbs" aria-label="위치"><a href="/@e.Date">@e.Date 호</a><span>@(s.Raw.Rank)위</span></nav>
    <h1><a href="@s.SourceUrl" target="_blank" rel="noopener" title="@(s.IsSelfPost ? "Hacker News 원문 보기" : "원문 보기")">@s.Title</a></h1>
    @if (e.Translated)
    {
      <p class="en"><a href="@s.HnUrl" target="_blank" rel="noopener" title="Hacker News 글 보기">@s.Raw.Title</a></p>
    }
    <partial name="_Meta" model="new Meta(s, true)" />
  </header>

  <main class="article">
    <div class="article-body">
      <partial name="_Visual" model="s" />
      <section class="article-text">
        @if (s.IsSelfPost && item.Translated && item.SplitLead() is { } split)
        {
          @* HN 본문 글은 첫 문단(굵은 한 줄 요약)을 "요약"으로, 나머지 전문 번역과 HN 반응을 "본문"으로 나눠 보여 준다. *@
          <h2>요약</h2>
          <div class="md">@MarkdownRenderer.Render(split.Lead)</div>
          <h2 class="body-head">본문</h2>
          <div class="md full">@MarkdownRenderer.Render(split.Body)</div>
        }
        else
        {
          <h2>@(s.IsSelfPost ? "본문" : "요약")</h2>
          @if (!item.Translated)
          {
            <p class="notice">아직 번역 전입니다. 원문 소개를 그대로 보여 드립니다.</p>
          }
          @if (item.Body is null)
          {
            <p class="meta">원문 사이트에서 내용을 확인해 주세요.</p>
          }
          else
          {
            <div class="md">@MarkdownRenderer.Render(item.Body)</div>
          }
        }
      </section>

      @* 본문 끝의 원문 링크. Slack이 링크를 펼쳐 보여 주는 미리보기처럼 원문의 사이트·원제·og 설명을 그대로 보여 준다.
         대표 이미지는 본문 위에 이미 있으므로 넣지 않는다. 칸 어디를 눌러도 원문이 열린다.
         파비콘은 원문 사이트의 /favicon.ico를 쓰고, 없으면 지운다. *@
      <aside class="unfurl linkbox" aria-label="원문 링크">
        <p class="unfurl-site">
          @if (Uri.TryCreate(s.SourceUrl, UriKind.Absolute, out var source))
          {
            <img src="https://@source.Host/favicon.ico" alt="" width="16" height="16" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
          }
          <span>@s.Raw.Site</span>
        </p>
        <h3><a href="@s.SourceUrl" target="_blank" rel="noopener">@s.Raw.Title</a></h3>
        @if (!string.IsNullOrWhiteSpace(s.Raw.Description))
        {
          <p class="unfurl-desc">@s.Raw.Description</p>
        }
      </aside>
    </div>

    <section class="comments" id="comments">
      <div class="sec-head"><h2><a href="@s.HnUrl" target="_blank" rel="noopener" title="Hacker News 댓글 보기">댓글</a></h2><span class="meta">@(item.Comments.Count)개 표시 · 전체 @(item.TotalComments)개</span></div>
      @if (item.Comments.Count == 0)
      {
        <p class="meta">@(item.Collected ? "아직 댓글이 없습니다." : "댓글을 아직 수집하지 않았습니다.")</p>
      }
      else if (!item.CommentsTranslated)
      {
        <p class="notice">댓글은 아직 번역 전이라 원문으로 보여 드립니다.</p>
      }
      <ol class="comment-list">
        @foreach (var c in item.Comments)
        {
          <li class="comment@(c.Depth == 0 ? " root" : "")" style="--depth:@c.Depth" data-depth="@c.Depth">
            <div class="comment-meta"><span class="by">@c.By</span><partial name="_Ago" model="c.Time" /><a href="@c.HnUrl" target="_blank" rel="noopener">HN</a></div>
            @if (c.Deleted)
            {
              <p class="deleted">삭제된 댓글입니다.</p>
            }
            else
            {
              <div class="md">@MarkdownRenderer.Render(c.Text)</div>
            }
          </li>
        }
      </ol>
      @if (item.Comments.Count > 0)
      {
        <script>
        // HN 댓글란처럼 메타 줄 끝의 [–]를 누르면 그 댓글과 딸린 답글을 모두 접고, 접힌 댓글 수를 [N개 더]로 보여 준다.
        // 댓글은 깊이만 가진 평평한 목록이므로, 뒤따르는 댓글 가운데 깊이가 더 깊은 것까지를 딸린 답글로 본다.
        // 펼칠 때 안쪽에서 따로 접어 둔 댓글은 접힌 채로 둔다. 스크립트가 없으면 버튼 없이 모두 펼쳐 보인다.
        (() => {
          const items = [...document.querySelectorAll('.comment-list > .comment')];
          const depth = items.map(li => Number(li.dataset.depth));
          const end = items.map((_, i) => {
            let j = i + 1;
            while (j < items.length && depth[j] > depth[i]) j++;
            return j;
          });
          const layout = () => {
            let hideUntil = 0;
            items.forEach((li, i) => {
              li.hidden = i < hideUntil;
              if (!li.hidden && li.classList.contains('collapsed')) hideUntil = end[i];
            });
          };
          items.forEach((li, i) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'toggle';
            const label = () => {
              const collapsed = li.classList.contains('collapsed');
              button.textContent = collapsed ? `[${end[i] - i}개 더]` : '[–]';
              button.title = collapsed ? '펼치기' : '접기';
              button.setAttribute('aria-expanded', String(!collapsed));
            };
            button.addEventListener('click', () => {
              li.classList.toggle('collapsed');
              label();
              layout();
            });
            label();
            li.querySelector('.comment-meta').append(button);
          });
        })();
        </script>
      }
      <p class="more-comments"><a href="@s.HnUrl" target="_blank" rel="noopener">Hacker News에서 보기 ↗</a></p>
    </section>

    <nav class="story-nav" aria-label="기사 이동">
      @if (Model.Prev is { } prev)
      {
        <a class="prev" href="@prev.Href"><span>← 이전 기사 · @(prev.Raw.Rank)위</span><strong>@prev.Title</strong></a>
      }
      else
      {
        <span></span>
      }
      <a class="home" href="/@e.Date">1면으로</a>
      @if (Model.Next is { } next)
      {
        <a class="next" href="@next.Href"><span>다음 기사 · @(next.Raw.Rank)위 →</span><strong>@next.Title</strong></a>
      }
    </nav>
  </main>

  <aside class="story-right" aria-label="이 호의 다른 기사">
    <div class="box">
      <div class="sec-head"><h2>많이 본 뉴스</h2></div>
      <ol class="ranking">
        @foreach (var (r, i) in e.ByPoints.Select((r, i) => (r, i + 1)))
        {
          <li class="linkbox@(r.Raw.Id == s.Raw.Id ? " current" : "")"><span class="n">@i</span><div><h3><a href="@r.Href">@r.Title</a></h3><p class="pts">▲ @r.Raw.Points</p></div></li>
        }
      </ol>
    </div>
    <div class="box">
      <div class="sec-head"><h2>댓글 많은 뉴스</h2></div>
      <ol class="ranking">
        @foreach (var (r, i) in e.ByComments.Select((r, i) => (r, i + 1)))
        {
          <li class="linkbox@(r.Raw.Id == s.Raw.Id ? " current" : "")"><span class="n">@i</span><div><h3><a href="@r.Href">@r.Title</a></h3><p class="pts">댓글 @r.Raw.Comments</p></div></li>
        }
      </ol>
    </div>
  </aside>
</div>
